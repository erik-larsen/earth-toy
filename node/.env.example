# Set ONE of the two. Both stream Google Photorealistic 3D Tiles.

# Option A (no credit card): free Cesium ion account — https://ion.cesium.com/signup
# After signing up: Access Tokens -> copy the default token
VITE_ION_TOKEN=

# Option B: Google Cloud API key with the "Map Tiles API" enabled (requires billing)
# https://console.cloud.google.com/google/maps-apis/api-list
VITE_GOOGLE_MAPS_API_KEY=
